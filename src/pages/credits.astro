---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  locale="ko"
  active=""
  path="credits"
  title="크레딧 | DFS Lab"
  description="DFS Lab 홈페이지에 사용한 사진의 출처와 라이선스"
>
  <div class="wrap">
    <h1>크레딧</h1>
    <p class="lede">이 사이트에 사용한 사진의 출처와 라이선스입니다.</p>

    <section class="block">
      <h2>사진</h2>
      <ul>
        <li>논문 지면 캡처(소식, Applied Sciences·Electronics) : MDPI, Open Access, CC BY 4.0</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .lede { font-size: 16px; max-width: 700px; margin-bottom: 32px; color: var(--text-muted-2); }
  .block { margin-bottom: 32px; max-width: 760px; }
  .block h2 { font-size: 18px; }
  ul { padding-left: 20px; }
  li { margin-bottom: 8px; font-size: 14px; color: var(--text-muted-2); }
</style>
