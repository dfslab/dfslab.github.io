---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPeople } from '../lib/data.js';

const { professor, researchers } = getPeople();
---
<BaseLayout
  locale="ko"
  active="people"
  path="people"
  title="구성원 | DFS Lab"
  description="DFS Lab 구성원: 지도교수 신지호, 학부연구생 신예준·문준수"
>
  <div class="wrap">
    <h1>구성원</h1>

    <section class="person prof">
      <h2>교수</h2>
      <div class="prof-layout">
        <img src={professor.photo} alt={professor.photo_alt_ko} class="prof-photo" loading="lazy" />
        <div class="prof-detail">
          <h3>{professor.name_ko} <span class="muted">({professor.name_en})</span></h3>
          <p class="email"><a href={`mailto:${professor.email}`}>{professor.email}</a></p>

          <h4>소속</h4>
          <ul>{professor.affiliation_ko.map((a: string) => <li>{a}</li>)}</ul>

          <h4>주요 경력</h4>
          <ul>{professor.experience_ko.map((e: string) => <li>{e}</li>)}</ul>

          <h4>학력</h4>
          <ul>{professor.education_ko.map((e: string) => <li>{e}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="person-group">
      <h2>연구원</h2>
      <div class="researcher-grid">
        {researchers.map((r: any) => (
          <div class="researcher card">
            <img src={r.photo} alt={r.photo_alt_ko} class="researcher-photo" loading="lazy" />
            <div class="researcher-body">
              <h3>{r.name_ko} <span class="muted">({r.name_en})</span></h3>
              <p class="status">{r.status_ko}</p>
              <p class="affil">목원대학교 컴퓨터융합학부</p>
              <p class="interests-label">연구 관심분야</p>
              <ul>{r.interests_ko.map((i: string) => <li>{i}</li>)}</ul>
              <p class="email"><a href={`mailto:${r.email}`}>{r.email}</a></p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .person { margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--border); }
  .muted { color: var(--text-muted); font-weight: 400; font-size: 16px; }
  h4 { font-size: 14px; color: var(--text-muted); margin: 20px 0 6px; }
  ul { margin: 0; padding-left: 20px; color: var(--text-muted-2); }
  li { margin-bottom: 4px; }
  .email { margin-top: 12px; }

  .prof-layout { display: flex; flex-direction: column; gap: 20px; margin-top: 16px; }
  @media (min-width: 720px) {
    .prof-layout { flex-direction: row; align-items: flex-start; }
  }
  .prof-photo {
    width: 220px;
    height: 293px;
    object-fit: cover;
    object-position: 50% 100%;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .prof-detail { flex: 1; min-width: 0; }

  .researcher-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 16px; }
  @media (min-width: 720px) { .researcher-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .researcher { display: flex; gap: 16px; align-items: flex-start; }
  .researcher-photo {
    width: 108px;
    height: 132px; /* 원본 증명사진 비율(532x648)에 맞춰 머리·어깨가 잘리지 않게 */
    object-fit: cover;
    object-position: 50% 50%;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .researcher-body { min-width: 0; }
  .researcher .status { color: var(--text-muted); font-size: 14px; margin-top: -8px; }
  .researcher .affil { color: var(--text-muted); font-size: 14px; margin-top: -4px; }
  .interests-label { font-size: 13px; color: var(--text-muted); margin: 12px 0 4px; }
</style>
