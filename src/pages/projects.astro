---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import { getProjects } from '../lib/data.js';

const projects = getProjects();
---
<BaseLayout
  locale="ko"
  active="projects"
  path="projects"
  title="프로젝트 | DFS Lab"
  description={`DFS Lab 프로젝트 목록 (총 ${projects.length}건)`}
>
  <div class="wrap">
    <h1>프로젝트</h1>
    <p class="intro">총 {projects.length}건.</p>
    <ProjectList locale="ko" projects={projects} />
  </div>
</BaseLayout>

<style>
  .intro { margin-bottom: 32px; }
</style>
