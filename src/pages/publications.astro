---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { getPublications } from '../lib/data.js';

const publications = getPublications();
---
<BaseLayout
  locale="ko"
  active="publications"
  path="publications"
  title="논문 | DFS Lab"
  description={`DFS Lab 논문 목록 (총 ${publications.length}편)`}
>
  <div class="wrap">
    <h1>논문</h1>
    <p class="intro">디지털포렌식과 사이버보안 분야에서 발표한 학술지 논문과 학술대회 논문입니다. (총 {publications.length}편)</p>
    <PublicationList locale="ko" publications={publications} />
  </div>
</BaseLayout>

<style>
  .intro { margin-bottom: 32px; }
</style>
