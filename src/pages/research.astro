---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResearchDetail } from '../data/research-detail.js';

const sections = getResearchDetail('ko');
---
<BaseLayout
  locale="ko"
  active="research"
  path="research"
  title="연구 | DFS Lab"
  description="DFS Lab의 다섯 가지 연구 분야: 데이터 복구, 침해사고 포렌식, 애플리케이션·시스템, 클라우드, 증거 검증."
>
  <div class="wrap">
    <h1>연구</h1>
    <p class="intro">디지털 기기와 서비스에 남은 데이터를 찾아내고, 디지털 증거로 쓸 수 있는지 검증합니다. 아래 다섯 가지 질문을 중심으로 연구를 진행합니다.</p>
    {sections.map((s) => (
      <section id={s.key} class="area">
        <span class="mono area-label">{s.label}</span>
        <h2>{s.heading}</h2>
        {s.body.map((p) => <p>{p}</p>)}
      </section>
    ))}
    <p class="more"><a href="/publications">전체 논문 목록 보기</a> · <a href="/projects">전체 프로젝트 보기</a></p>
    <p class="photo-credit"><a href="/credits">사진 출처</a></p>
  </div>
</BaseLayout>

<style>
  .intro { font-size: 17px; max-width: 760px; margin-bottom: 40px; }
  .area { padding: 28px 0; border-top: 1px solid var(--border); }
  .area:first-of-type { border-top: none; }
  .area-label { font-size: 13px; color: var(--link); }
  .area h2 { margin-top: 8px; max-width: 760px; }
  .area p { max-width: 760px; }
  .more { margin-top: 24px; font-weight: 600; }
  .photo-credit { margin-top: 32px; font-size: 12px; }
  .photo-credit a { color: var(--text-muted); }
</style>
