---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import { getPublications } from '../../lib/data.js';

const publications = getPublications();
---
<BaseLayout
  locale="en"
  active="publications"
  path="publications"
  title="Publications | DFS Lab"
  description={`DFS Lab publication list (${publications.length} total)`}
>
  <div class="wrap">
    <h1>Publications</h1>
    <p class="intro">Journal articles and conference papers published in the fields of digital forensics and cybersecurity. ({publications.length} total)</p>
    <PublicationList locale="en" publications={publications} />
  </div>
</BaseLayout>

<style>
  .intro { margin-bottom: 32px; }
</style>
