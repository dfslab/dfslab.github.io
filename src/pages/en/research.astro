---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResearchDetail } from '../../data/research-detail.js';

const sections = getResearchDetail('en');
---
<BaseLayout
  locale="en"
  active="research"
  path="research"
  title="Research | DFS Lab"
  description="DFS Lab's four research areas: data recovery, applications, cloud, and evidence verification."
>
  <div class="wrap">
    <h1>Research</h1>
    <p class="intro">We locate the data left behind on digital devices and services, and verify whether it holds up as evidence. Our work is organized around the four questions below.</p>
    {sections.map((s) => (
      <section id={s.key} class="area">
        <span class="mono area-label">{s.label}</span>
        <h2>{s.heading}</h2>
        {s.body.map((p) => <p>{p}</p>)}
      </section>
    ))}
    <p class="more"><a href="/en/publications">See all publications</a> · <a href="/en/projects">See all projects</a></p>
  </div>
</BaseLayout>

<style>
  .intro { font-size: 17px; max-width: 760px; margin-bottom: 40px; }
  .area { padding: 28px 0; border-top: 1px solid var(--border); }
  .area:first-of-type { border-top: none; }
  .area-label { font-size: 13px; color: var(--link); }
  .area h2 { margin-top: 8px; max-width: 760px; }
  .area p { max-width: 760px; }
  .more { margin-top: 24px; font-weight: 600; }
</style>
