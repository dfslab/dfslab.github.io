---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPeople } from '../../lib/data.js';

const { professor, researchers } = getPeople();
---
<BaseLayout
  locale="en"
  active="people"
  path="people"
  title="People | DFS Lab"
  description="DFS Lab members: Professor Jiho Shin, undergraduate researchers Yejun Shin and Moon Junsu"
>
  <div class="wrap">
    <h1>People</h1>

    <section class="person prof">
      <h2>Professor</h2>
      <div class="prof-layout">
        <img src={professor.photo} alt={professor.photo_alt_en} class="prof-photo" loading="lazy" />
        <div class="prof-detail">
          <h3>{professor.name_en} <span class="muted">({professor.name_ko})</span></h3>
          <p class="email"><a href={`mailto:${professor.email}`}>{professor.email}</a></p>
          <p class="cv-link"><a href={professor.cv_url_en} target="_blank" rel="noopener noreferrer">CV ↗</a></p>

          <h4>Affiliation</h4>
          <ul>{professor.affiliation_en.map((a: string) => <li>{a}</li>)}</ul>

          <h4>Professional Experience</h4>
          <ul>{professor.experience_en.map((e: string) => <li>{e}</li>)}</ul>

          <h4>Academic Background</h4>
          <ul>{professor.education_en.map((e: string) => <li>{e}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="person-group">
      <h2>Researchers</h2>
      <div class="researcher-grid">
        {researchers.map((r: any) => (
          <div class="researcher card">
            <img src={r.photo} alt={r.photo_alt_en} class="researcher-photo" loading="lazy" />
            <div class="researcher-body">
              <h3>{r.name_en} <span class="muted">({r.name_ko})</span></h3>
              <p class="status">{r.status_en}</p>
              <p class="affil">Division of Computer Science Convergence, Mokwon University</p>
              <p class="interests-label">Research Interests</p>
              <ul>{r.interests_en.map((i: string) => <li>{i}</li>)}</ul>
              <p class="email"><a href={`mailto:${r.email}`}>{r.email}</a></p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .person { margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--border); }
  .muted { color: var(--text-muted); font-weight: 400; font-size: 16px; }
  h4 { font-size: 14px; color: var(--text-muted); margin: 20px 0 6px; }
  ul { margin: 0; padding-left: 20px; color: var(--text-muted-2); }
  li { margin-bottom: 4px; }
  .email { margin-top: 12px; }
  .cv-link { margin-top: 8px; }
  .cv-link a { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border: 1px solid currentColor; border-radius: 4px; font-size: 14px; font-weight: 600; line-height: 1.6; text-decoration: none; }
  .cv-link a:hover { background: var(--link); color: var(--bg, #fff); }

  .prof-layout { display: flex; flex-direction: column; gap: 20px; margin-top: 16px; }
  @media (min-width: 720px) {
    .prof-layout { flex-direction: row; align-items: flex-start; }
  }
  .prof-photo {
    width: 220px;
    height: 293px;
    object-fit: cover;
    object-position: 50% 100%;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .prof-detail { flex: 1; min-width: 0; }

  .researcher-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 16px; }
  @media (min-width: 720px) { .researcher-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .researcher { display: flex; gap: 16px; align-items: flex-start; }
  .researcher-photo {
    width: 108px;
    height: 132px; /* 원본 증명사진 비율(532x648)에 맞춰 머리·어깨가 잘리지 않게 */
    object-fit: cover;
    object-position: 50% 50%;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .researcher-body { min-width: 0; }
  .researcher .status { color: var(--text-muted); font-size: 14px; margin-top: -8px; }
  .researcher .affil { color: var(--text-muted); font-size: 14px; margin-top: -4px; }
  .interests-label { font-size: 13px; color: var(--text-muted); margin: 12px 0 4px; }
</style>
