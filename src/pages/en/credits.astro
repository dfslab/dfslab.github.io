---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  locale="en"
  active=""
  path="credits"
  title="Credits | DFS Lab"
  description="Sources and licenses for the photos used on the DFS Lab website"
>
  <div class="wrap">
    <h1>Credits</h1>
    <p class="lede">Sources and licenses for the photos used on this site.</p>

    <section class="block">
      <h2>Photos</h2>
      <ul>
        <li>Paper first-page captures (News, Applied Sciences and Electronics) : MDPI, Open Access, CC BY 4.0</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .lede { font-size: 16px; max-width: 700px; margin-bottom: 32px; color: var(--text-muted-2); }
  .block { margin-bottom: 32px; max-width: 760px; }
  .block h2 { font-size: 18px; }
  ul { padding-left: 20px; }
  li { margin-bottom: 8px; font-size: 14px; color: var(--text-muted-2); }
</style>
