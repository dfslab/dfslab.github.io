---
import { getHomeCards } from '../data/home-cards.js';
import { HOME_DIAGRAMS } from '../data/home-diagrams.js';
import { localeHref } from '../lib/nav.js';

interface Props {
  locale: 'ko' | 'en';
}
const { locale } = Astro.props as Props;
const cards = getHomeCards(locale);
---
<section class="card-grid">
  {cards.map((card) => (
    <a href={`${localeHref(locale, 'research')}#${card.key}`} class={`rcard ${card.dark ? 'rcard-dark' : ''}`}>
      <div class="rcard-dg" role="img" aria-label={card.alt} set:html={HOME_DIAGRAMS[card.key]} />
      <div class="rcard-body">
        <span class="mono rcard-label">{card.label}</span>
        <span class="rcard-heading">{card.heading}</span>
        <span class="rcard-sub">{card.sub}</span>
      </div>
    </a>
  ))}
</section>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 768px) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  }
  @media (min-width: 1100px) {
    .card-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  .rcard {
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    color: var(--text);
    overflow: hidden;
  }
  .rcard-dark {
    background: var(--invert-bg);
    color: var(--invert-text);
    border-color: var(--invert-bg);
  }
  .rcard-dg {
    height: 170px;
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    color: var(--text);
    --ac: var(--link);
    --mu: color-mix(in srgb, currentColor 35%, transparent);
    --acbg: color-mix(in srgb, var(--ac) 12%, transparent);
  }
  .rcard-dark .rcard-dg {
    color: var(--invert-text);
    --ac: var(--accent-invert);
    border-bottom-color: color-mix(in srgb, currentColor 14%, transparent);
  }
  .rcard-body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }
  .rcard-label {
    font-size: 13px;
    color: var(--link);
  }
  .rcard-dark .rcard-label { color: var(--accent-invert); }
  .rcard-heading {
    font-size: 20px;
    line-height: 1.45;
    font-weight: 600;
  }
  .rcard-sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: auto;
  }
  .rcard-dark .rcard-sub { color: var(--muted-invert); }
</style>

<style is:global>
  /* 도식은 set:html로 넣어 범위 지정이 붙지 않으므로 전역 스타일로 둔다. */
  .rcard-dg svg { width: 100%; height: 100%; display: block; }
  .dg-t { font-family: 'IBM Plex Mono', monospace; font-size: 8.5px; fill: currentColor; }
  .dg-b { font-weight: 600; }
  .dg-tm { fill: var(--mu); }
  .dg-ta { fill: var(--ac); }
  .dg-l { stroke: currentColor; stroke-width: 1.2; fill: none; }
  .dg-la { stroke: var(--ac); stroke-width: 1.6; fill: none; }
  .dg-m { stroke: var(--mu); stroke-width: 1; fill: none; }
  .dg-dash { stroke: var(--mu); stroke-width: 1; stroke-dasharray: 3 3; }
  .dg-nf { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .dg-cell { fill: none; stroke: var(--mu); stroke-width: 1; }
  .dg-fill { fill: currentColor; }
  .dg-acc { fill: var(--acbg); stroke: var(--ac); stroke-width: 1.2; stroke-dasharray: 2.5 2; }
  .dg-box { fill: none; stroke: currentColor; stroke-width: 1.2; }
  .dg-ring { fill: var(--acbg); stroke: var(--ac); stroke-width: 1.4; }
  .dg-dot { fill: var(--surface); stroke: currentColor; stroke-width: 1.4; }
  .dg-dota { fill: var(--ac); }
</style>
