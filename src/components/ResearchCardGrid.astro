---
import { getHomeCards } from '../data/home-cards.js';
import { localeHref } from '../lib/nav.js';

interface Props {
  locale: 'ko' | 'en';
}
const { locale } = Astro.props as Props;
const cards = getHomeCards(locale);
---
<section class="card-grid">
  {cards.map((card) => (
    <a href={`${localeHref(locale, 'research')}#${card.key}`} class={`rcard ${card.dark ? 'rcard-dark' : ''}`}>
      {card.kind === 'image' && (
        <img src={card.image} alt={card.alt} class="rcard-media" loading="lazy" />
      )}
      {card.kind === 'icons' && (
        <div class="rcard-icons" style={`grid-template-columns: repeat(${card.iconCols || 4}, minmax(0, 1fr));`}>
          {card.icons.map((icon) => (
            <div class="rcard-icon-tile">
              <img src={icon.file} alt={locale === 'ko' ? icon.ko : icon.en} loading="lazy" />
            </div>
          ))}
        </div>
      )}
      <div class="rcard-body">
        <span class="mono rcard-label">{card.label}</span>
        <span class="rcard-heading">{card.heading}</span>
        <span class="rcard-sub">{card.sub}</span>
      </div>
    </a>
  ))}
</section>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 768px) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  }
  @media (min-width: 1100px) {
    .card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .rcard {
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    color: var(--text);
    overflow: hidden;
  }
  .rcard-dark {
    background: var(--invert-bg);
    color: var(--invert-text);
    border-color: var(--invert-bg);
  }
  .rcard-media {
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-bottom: 1px solid var(--border-soft);
  }
  .rcard-icons {
    height: 170px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 1px;
    /* 로고 타일 배경은 라이트/다크 모드와 무관하게 항상 흰색으로 고정한다(어두운 배경에서
       검정 워드마크 로고가 안 보이는 문제 방지). */
    background: #e4e6ea;
    border-bottom: 1px solid #e4e6ea;
  }
  .rcard-icon-tile {
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rcard-icon-tile img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }
  .rcard-body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }
  .rcard-label {
    font-size: 13px;
    color: var(--link);
  }
  .rcard-dark .rcard-label { color: var(--accent-invert); }
  .rcard-heading {
    font-size: 20px;
    line-height: 1.45;
    font-weight: 600;
  }
  .rcard-sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: auto;
  }
  .rcard-dark .rcard-sub { color: var(--muted-invert); }
</style>
