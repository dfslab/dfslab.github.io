---
import { localeHref } from '../lib/nav.js';

interface Props {
  locale: 'ko' | 'en';
}
const { locale } = Astro.props as Props;
const isKo = locale === 'ko';
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>Digital Forensics &amp; Security Laboratory</div>
    <div>{isKo ? '목원대학교 컴퓨터융합학부' : 'Division of Computer Science Convergence, Mokwon University'}</div>
    <div>{isKo ? '#D425, 공학관(D동), 대전광역시 서구 도안북로 88' : '#D425, Engineering Building (D), 88 Doanbuk-ro, Seo-gu, Daejeon'}</div>
    <div><a href="mailto:suchme@gmail.com">suchme@gmail.com</a></div>
    <div><a href={localeHref(locale, 'credits')}>{isKo ? '사진 출처' : 'Photo Credits'}</a></div>
  </div>
</footer>
